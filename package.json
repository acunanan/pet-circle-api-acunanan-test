  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:petApi": "cypress run cypress/e2e/api/pet-api/*.js",
    "test:createNewPet": "cypress run --spec cypress/e2e/api/pet-api/createNewPetSpec.cy.js",
    "test:getPetById": "cypress run --spec cypress/e2e/api/pet-api/getPetSpec.cy.js",
    "test:updatePetById": "cypress run --spec cypress/e2e/api/pet-api/updatePetSpec.cy.js",
    "test:deletePetById": "cypress run --spec cypress/e2e/api/pet-api/deletePetSpec.cy.js"
  },
  "reporter": "mochawesome",
  "reporterOptions": {
    "reportDir": "cypress/reports",
    "overwrite": false,
    "html": true,
    "json": true
  },
  "keywords": [],
